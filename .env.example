# Ay'la — Environment örneği
# cp .env.example .env

# Neon / PostgreSQL (gerçek URL'yi yalnızca .env'ye yaz)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.aws.neon.tech/neondb?sslmode=require"
# Yerel SQLite yedek (artık varsayılan değil):
# DATABASE_URL="file:./dev.db"

AUTH_SECRET="change-me-in-production"
ADMIN_EMAIL="admin@ayla.restaurant"
ADMIN_PASSWORD="change-me"
# FORCE_ADMIN_PASSWORD_RESET=1

MENU_BASE_URL="http://menu.localhost:3000"
NEXT_PUBLIC_SITE_URL="https://aylaalanya.com"
GOOGLE_PLACES_API_KEY=""

# Rezervasyon bildirimleri (boş / NOTIFY_DEMO_MODE=1 = konsol demo)
NOTIFY_DEMO_MODE=1
RESEND_API_KEY=
RESEND_FROM_EMAIL="Ay'la <reservation@aylaalanya.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
